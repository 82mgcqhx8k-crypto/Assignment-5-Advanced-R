> # Sort chromosome labels numerically where possible, then alphabetically
> df_filtered$Chromosome <- trimws(as.character(df_filtered$Chromosome))
> 
> sort_chromosomes <- function(chroms) {
+   unique_c <- unique(chroms)
+   clean_c <- gsub("^chr", "", tolower(unique_c))
+   is_num <- grepl("^[0-9]+$", clean_c)
+   
+   num_part <- unique_c[is_num][order(as.numeric(clean_c[is_num]))]
+   char_part <- unique_c[!is_num][order(clean_c[!is_num])]
+   
+   c(num_part, char_part)
+ }
